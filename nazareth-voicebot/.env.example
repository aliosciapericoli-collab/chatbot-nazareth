# Server
PORT=3000
# URL pubblico del server, uguale a quello configurato come webhook su Twilio
PUBLIC_BASE_URL=https://voicebot.example.com

# Anthropic
ANTHROPIC_API_KEY=
# Modello (default: claude-haiku-4-5-20251001, il Haiku più recente)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Tempo massimo di attesa della risposta di Claude (Twilio abbandona il webhook dopo 15 s)
CLAUDE_TIMEOUT_MS=8000
# Lunghezza massima della risposta in token
CLAUDE_MAX_TOKENS=300
# Domande massime per chiamata
CONVERSATION_MAX_TURNS=10

# Provider telefonico (adattatore in src/provider/)
TELEPHONY_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Verifica della firma Twilio: metti false SOLO in locale per provare con curl
TWILIO_VALIDATE_SIGNATURE=true
# Voce sintetica italiana (elenco: https://www.twilio.com/docs/voice/twiml/say/text-speech)
TTS_VOICE=Polly.Bianca-Neural

# Reception: numero (E.164) e secondi di squillo prima di passare all'assistente
RECEPTION_PHONE_NUMBER=+3907611564612
RECEPTION_DIAL_TIMEOUT=20
# false se la reception viene già fatta squillare prima del bot (es. Asterisk con Messagenet)
RECEPTION_FORWARD=true

# Solo per i test: chiusa | aperta forzano la modalità; auto (default) segue l'orario
RECEPTION_MODE=auto

# Richiamata: email alla reception (senza SMTP_HOST le richieste non vengono inviate)
SMTP_HOST=
# 587 = STARTTLS, 465 = TLS diretto
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CALLBACK_EMAIL_TO=info@nazarethresidence.com
# Mittente; se vuoto si usa SMTP_USER
CALLBACK_EMAIL_FROM=

# Prezzi e disponibilità in tempo reale dal motore di prenotazione WuBook
WUBOOK_ENABLED=true
WUBOOK_EP=17104f2c
WUBOOK_TIMEOUT_MS=4000

# Marchio: la dashboard si presenta come "<APP_NAME> · <CLIENT_NAME>"
APP_NAME=Vocalba
CLIENT_NAME=Nazareth Residence

# Dashboard su /dashboard (vuota = disattivata). Usa una password lunga.
DASHBOARD_PASSWORD=
# Facoltativo: segreto aggiuntivo per le sessioni (cambiandolo si esce da tutti i dispositivi)
SESSION_SECRET=

# Fuso orario usato per orari e disponibilità
TIMEZONE=Europe/Rome
