# Server
PORT=3000
# URL pubblico del server, uguale a quello configurato come webhook su Twilio
PUBLIC_BASE_URL=https://voicebot.example.com

# Anthropic
ANTHROPIC_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Verifica della firma Twilio: metti false SOLO in locale per provare con curl
TWILIO_VALIDATE_SIGNATURE=true
# Voce sintetica italiana (elenco: https://www.twilio.com/docs/voice/twiml/say/text-speech)
TTS_VOICE=Polly.Bianca-Neural

# Reception: numero (E.164) e secondi di squillo prima di passare all'assistente
RECEPTION_PHONE_NUMBER=+3907611564612
RECEPTION_DIAL_TIMEOUT=20

# Fuso orario usato per orari e disponibilità
TIMEZONE=Europe/Rome
